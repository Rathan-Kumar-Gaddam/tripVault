# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB URI)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/tripvault?retryWrites=true&w=majority

# Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# APITXT Configuration (SMS & OTP Gateway)
APITXT_AUTH_KEY=your_apitxt_auth_key_here
APITXT_SENDER_ID=TRPVLT
APITXT_PE_ID=your_dlt_principal_entity_id
APITXT_DEFAULT_DLT_TEMPLATE_ID=your_dlt_template_id
APITXT_DEFAULT_ROUTE=4
APITXT_DEFAULT_COUNTRY=91
APITXT_PROJECT_REF_ID=PROJ_xxx
